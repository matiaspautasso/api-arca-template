# Credenciales ARCA (clave fiscal) — NUNCA versionar los valores reales.
# Copiar a .env (ignorado por git) y completar.

# CUIT que inicia sesión (persona física)
ARCA_CUIT=20XXXXXXXXX

# Clave fiscal (NO escribir el valor real aquí; va en .env)
ARCA_PASSWORD=********

# Empresa a representar tras loguear
ARCA_EMPRESA="NOMBRE DE LA EMPRESA A REPRESENTAR"

# Portal de login
ARCA_LOGIN_URL=https://auth.afip.gob.ar/contribuyente_/login.xhtml

# Playwright: true => sin ventana (producción) | false => con ventana (debug/primer run)
HEADLESS=false


# Token que exige POST /sync (cron y botón 'Actualizar'). Vacío => sin auth (dev).
SYNC_TOKEN=

# Solo para el job de cron (scripts/sync_semanal.py): URL pública de la API.
SYNC_API_URL=

# Base de datos (Postgres). Local: el contenedor de docker-compose (127.0.0.1, NO
# localhost: en Windows es ~100x más lento). En Railway se inyecta sola.
DATABASE_URL=postgresql://arca:arca@127.0.0.1:5440/arca

# Orígenes permitidos para un frontend (separados por coma).
CORS_ORIGINS=http://localhost:3000
